# ── Server ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── Database ────────────────────────────────────────────────────────────
# MongoDB Atlas connection string (or local: mongodb://127.0.0.1:27017/botanica-erp)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/botanica-erp

# ── CORS ────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins. Required if frontend
# and backend run on different domains/ports.
CORS_ORIGIN=http://localhost:5173

# ── JWT ─────────────────────────────────────────────────────────────────
# Generate strong secrets with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_64_byte_random_hex_string
JWT_REFRESH_SECRET=replace_with_a_different_64_byte_random_hex_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── Web Push (Firebase Cloud Messaging / Web Push API, VAPID) ─────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ── Transactional Email (Nodemailer SMTP — works with Resend's SMTP relay) ─
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASS=your_resend_or_smtp_api_key
EMAIL_FROM="Botanica ERP <no-reply@yourdomain.com>"

# ── Seed script (optional, used by `npm run seed`) ────────────────────────
SEED_STORE_NAME=Botanica Apothecary
SEED_DEFAULT_CURRENCY=USD
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
